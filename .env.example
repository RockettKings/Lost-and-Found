# Local development only. Copy this file to .env; never commit .env.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Leave blank to use instance/lost_found.sqlite3 locally.
DATABASE_URL=

# Optional until the team connects cloud photo storage. Keep the bucket private.
S3_BUCKET=
AWS_DEFAULT_REGION=us-east-1
# Prefer an IAM role on AWS; otherwise supply a dedicated, limited IAM user's keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Temporary credentials also require AWS_SESSION_TOKEN.
AWS_SESSION_TOKEN=
